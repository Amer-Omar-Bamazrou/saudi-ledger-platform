# Base44 development defaults — placeholders only. Real secrets come from
# /run/base44/app.env (listed AFTER this file in compose env_file, so they win).
# DO NOT put real credentials here.

# Session-cookie signing key (min 32 chars). Overridden by the generated secret
# in /run/base44/app.env.
SESSION_SECRET=base44-dev-placeholder-not-for-production-use-000000000000000000

# ZATCA local-dev envelope-encryption master key (dev only; refused in production).
ZATCA_DEV_MASTER_KEY=local-development-only-not-a-real-secret-0123456789
