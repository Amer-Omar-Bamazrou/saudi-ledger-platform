{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:sample": "tsx src/scripts/seedSampleData.ts",
    "benchmark:categorizer": "tsx src/scripts/benchmark/benchmarkCategorizer.ts",
    "benchmark:vision": "tsx src/scripts/benchmark/benchmarkVision.ts"
  },
  "dependencies": {
    "@peculiar/asn1-csr": "^2.8.0",
    "@peculiar/asn1-ecc": "^2.8.0",
    "@peculiar/asn1-schema": "^2.8.0",
    "@peculiar/asn1-x509": "^2.8.0",
    "@peculiar/x509": "^2.0.0",
    "@types/multer": "^2.2.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/config": "workspace:*",
    "@workspace/db": "workspace:*",
    "@xmldom/xmldom": "^0.9.10",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "tesseract.js": "^7.0.0",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^4.0.3",
    "xpath": "^0.0.34",
    "@workspace/zatca-tlv": "workspace:*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.10",
    "tsx": "^4.19.0"
  }
}
