# API server environment — copy to .env and fill in. Validated at boot by
# @workspace/config; the app refuses to start if anything here is missing/invalid.

# Postgres connection string (Supabase local default shown).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Session-cookie signing key. MUST be at least 32 characters. No fallback exists.
# Generate a strong one, e.g.: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Port the API listens on.
PORT=3000

# development | test | production. Controls secure cookies + trust proxy.
NODE_ENV=development

# Comma-separated exact origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Non-owner, non-BYPASSRLS Postgres role the app drops to per request so RLS is
# enforced. On local Supabase this is the built-in `authenticated` role.
DB_APP_ROLE=authenticated

# ── Document storage (M11.4) — OPTIONAL. Without these, verification-document
# upload/download returns 503; everything else works. All document I/O is
# brokered through the API, so the SERVICE-ROLE key stays server-side only —
# never expose it to the browser. On local Supabase, get these from
# `supabase status` (API URL + service_role key).
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
# VERIFICATION_DOCS_BUCKET=verification-documents

# ── Invitations (M11.7) — OPTIONAL, both have defaults.
# How long an invite link stays valid (days). Default 7.
# INVITATION_EXPIRY_DAYS=7
# Absolute base URL used to build invite links. Defaults to the first entry in
# CORS_ALLOWED_ORIGINS. NOTE: no email provider is integrated — the API returns
# the invite link for an admin to share out of band (see lib/mailer.ts).
# APP_BASE_URL=http://localhost:5173

# ── ZATCA credential vault (M12.5) ──────────────────────────────────────────
# Envelope encryption for tenant ZATCA signing keys: a per-company data key
# encrypts the private key, and that data key is wrapped by a KMS master key.
#
# The provider is chosen HERE, at deployment — not compiled in — because the KSA
# data-residency decision is still open and committing to a KMS partially
# pre-decides the hosting provider.
#
# aws-kms | local-dev (default: local-dev)
# ZATCA_KMS_PROVIDER=local-dev
#
# 🔴 'local-dev' is REFUSED in production (@workspace/config fails at boot, and
# the signing service refuses rows stored with it). It encrypts every tenant's
# signing key with a value from this file — fine for development, never for real
# taxpayer credentials. Any 32+ character string works.
ZATCA_DEV_MASTER_KEY=local-development-only-not-a-real-secret-0123456789
#
# For ZATCA_KMS_PROVIDER=aws-kms, ZATCA_KMS_KEY_ID is REQUIRED. Use ONE platform
# CMK wrapping per-company data keys — never one CMK per tenant (~$1/key/month
# would be $1,000/month at 1,000 tenants for identical isolation). Installing
# @aws-sdk/client-kms is a deployment step; it is not a package dependency.
# ZATCA_KMS_PROVIDER=aws-kms
# ZATCA_KMS_KEY_ID=arn:aws:kms:<region>:<account>:key/<key-id>
# ZATCA_KMS_REGION=me-south-1

# ── AI (optional — AI-1a) ────────────────────────────────────────────────────
# AI features are OFF by default; every feature degrades to its deterministic
# path. To enable the Groq second-opinion path in development:
#   AI_PROVIDER=groq
#   GROQ_API_KEY=gsk_your_key_here
# 🔴 In production, AI_PROVIDER=groq REFUSES to boot until the Groq Enterprise
# agreement (Dammam pinning + contractual ZDR) is signed and attested via
# GROQ_DATA_BOUNDARY_ACK — see packages/config/src/env.ts. The free tier
# routes globally and must never carry tenant data.
#AI_PROVIDER=none
#GROQ_API_KEY=
