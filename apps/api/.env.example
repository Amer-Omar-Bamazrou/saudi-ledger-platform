# API server environment — copy to .env and fill in. Validated at boot by
# @workspace/config; the app refuses to start if anything here is missing/invalid.

# Postgres connection string (Supabase local default shown).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Session-cookie signing key. MUST be at least 32 characters. No fallback exists.
# Generate a strong one, e.g.: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Port the API listens on.
PORT=3000

# development | test | production. Controls secure cookies + trust proxy.
NODE_ENV=development

# Comma-separated exact origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Non-owner, non-BYPASSRLS Postgres role the app drops to per request so RLS is
# enforced. On local Supabase this is the built-in `authenticated` role.
DB_APP_ROLE=authenticated

# ── Document storage (M11.4) — OPTIONAL. Without these, verification-document
# upload/download returns 503; everything else works. All document I/O is
# brokered through the API, so the SERVICE-ROLE key stays server-side only —
# never expose it to the browser. On local Supabase, get these from
# `supabase status` (API URL + service_role key).
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
# VERIFICATION_DOCS_BUCKET=verification-documents

# ── Invitations (M11.7) — OPTIONAL, both have defaults.
# How long an invite link stays valid (days). Default 7.
# INVITATION_EXPIRY_DAYS=7
# Absolute base URL used to build invite links. Defaults to the first entry in
# CORS_ALLOWED_ORIGINS. NOTE: no email provider is integrated — the API returns
# the invite link for an admin to share out of band (see lib/mailer.ts).
# APP_BASE_URL=http://localhost:5173
