# Web (Vite) environment — copy to .env and adjust if needed.
# These are read by vite.config.ts at config load; the dev/build/preview
# commands fail fast if PORT or BASE_PATH is missing.

# Port the Vite dev/preview server listens on.
PORT=5173

# Public base path the app is served under. Use "/" for local development.
# NOTE (Git Bash on Windows): setting BASE_PATH=/ on the command line can be
# mangled into a filesystem path — prefer setting it here in .env.
BASE_PATH=/

# DEV ONLY — where the Vite dev server proxies "/api" to (the API server).
# The frontend always calls the API same-origin at "/api"; in local two-port
# dev this proxy forwards those calls to the API. Ignored by the production
# build. Defaults to http://localhost:3000 if unset; override if the API runs
# on a different port/host.
API_PROXY_TARGET=http://localhost:3000
